{
  "manifest_version": 3,
  "name": "ReadLater TTS",
  "version": "0.1.0",
  "description": "Listen to any web page. Save to a queue, read later, or right now.",
  "permissions": ["storage", "activeTab", "scripting", "tts"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "play-current": {
      "suggested_key": { "default": "Ctrl+Shift+P" },
      "description": "Play current page"
    }
  }
}
